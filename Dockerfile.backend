# Step 1: Build Go backend
FROM golang:1.27-bookworm AS builder

WORKDIR /src

# Download Go dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy application source
COPY . .

# SQLite requires CGO and a C compiler
RUN CGO_ENABLED=1 GOOS=linux \
    go build -trimpath -o /out/webapi ./cmd/webapi

# Step 2: Run the application
FROM debian:bookworm-slim

WORKDIR /app

# Directory for SQLite database
RUN mkdir -p /data

# Copy only compiled application
COPY --from=builder /out/webapi /app/webapi

EXPOSE 3000

ENTRYPOINT ["/app/webapi"]
